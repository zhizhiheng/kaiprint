{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zhizhiheng/kaiprint",
  "title": "KaiPrint",
  "description": "Read and edit photo metadata and render camera-logo watermarks in a local photo directory.",
  "repository": {
    "url": "https://github.com/zhizhiheng/kaiprint",
    "source": "github"
  },
  "version": "0.0.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@kkellyoffical/kaiprint",
      "version": "0.0.3",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp", "valueHint": "command" },
        {
          "type": "named",
          "name": "--root",
          "format": "filepath",
          "description": "Photo directory KaiPrint can read and write",
          "isRequired": true
        }
      ]
    }
  ]
}
