{
  "name": "@kkellyoffical/kaiprint",
  "version": "0.0.3",
  "description": "Local photography watermarks and original metadata editing for CLI, MCP and agent skills",
  "author": "kkellyoffical",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhizhiheng/kaiprint.git"
  },
  "homepage": "https://github.com/zhizhiheng/kaiprint#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "kaiprint": "cli/kaiprint.js",
    "kaiprint-mcp": "cli/mcp.js"
  },
  "files": [
    "cli/*.js",
    "cli/models.json",
    "docs/cli.md",
    "docs/brand-marks.md",
    "app/src/main/assets/brands/*.svg",
    "app/src/main/assets/models/**/*.svg",
    "model-marks/catalog.csv",
    "app/src/main/assets/places/cities.tsv",
    "skills/kaiprint/SKILL.md",
    "docs/agents.md",
    "server.json",
    "formats/kaiphoto-template-v1.schema.json",
    "docs/preset-format.md",
    "examples/presets/*"
  ],
  "scripts": {
    "test": "node --test cli/test/cli.test.js cli/test/metadata.test.js cli/test/mcp.test.js cli/test/preset.test.js",
    "lint": "prettier --check \"cli/**/*.js\" package.json",
    "check": "npm run lint && npm test && python3 tools/check-project.py"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "exifr": "7.1.3",
    "exiftool-vendored": "39.4.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  },
  "mcpName": "io.github.zhizhiheng/kaiprint"
}
